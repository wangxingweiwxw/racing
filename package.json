{
  "name": "nurburgring-kart",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MPL-2.0",
  "scripts": {
    "data": "python3 tools/build_data.py && python3 tools/build_textures.py",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:worker": "node --test worker/index.test.js",
    "test:car": "node --experimental-transform-types --test tools/carCollision.test.mjs tools/driving.test.mjs",
    "deploy:pages": "npm run build && npx wrangler@4.147.0 pages deploy dist --project-name racing-wangxingweiwxw --branch main",
    "deploy:worker": "npx wrangler@4.147.0 deploy",
    "deploy": "npm run test:car && npm run test:worker && npm run deploy:pages && npm run deploy:worker"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
